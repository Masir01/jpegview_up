# Set default behavior to automatically handle line endings
* text=auto

# Explicitly declare text files that should always have LF line endings
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.c text eol=lf

# Scripts directory - critical for patch tools
extras/scripts/* text eol=lf
extras/scripts/**/*.bat text eol=lf

# Patch files must use LF
*.patch text eol=lf
*.diff text eol=lf

# Declare files that will always have CRLF line endings on checkout
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.dll binary
*.exe binary
*.lib binary
*.obj binary
*.o binary
*.a binary
*.so binary
*.dylib binary
*.pdf binary
*.zip binary
*.7z binary
*.rar binary
