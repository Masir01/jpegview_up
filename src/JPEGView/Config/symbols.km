#define IDM_BATCH_COPY 2600                   // 打开批量复制对话框
#define IDM_RENAME 2610                      // 重命名当前文件（需要显示处理面板）
#define IDM_MOVE_TO_RECYCLE_BIN 2620         // 删除文件（移至回收站，无确认）
#define IDM_MOVE_TO_RECYCLE_BIN_CONFIRM 2621 // 删除文件（移至回收站，有确认）
#define IDM_MOVE_TO_RECYCLE_BIN_CONFIRM_PERMANENT_DELETE 2622 // 删除文件（无回收站时提示永久删除）

// ----- 文件时间属性 -----
