// ============================================================
// JPEGView 快捷键符号配置文件
// ============================================================
// 此文件定义所有可用命令的符号名称
// 格式: #define 符号名 数值
// ============================================================

// ----- 基础命令 -----
#define IDM_DONOTHING 1                      // 无操作（用于禁用快捷键）
#define IDM_DEFAULT_ESC 255                  // ESC默认操作
#define IDM_MINIMIZE 1010                    // 最小化窗口

// ----- 文件操作 -----
#define IDM_OPEN 1100                        // 打开文件
#define IDM_EXPLORE 1101                     // 在资源管理器中打开并选中文件
#define IDM_SAVE 1500                        // 保存为原尺寸文件（需要确认覆盖）
#define IDM_SAVE_SCREEN 1501                 // 保存为屏幕尺寸文件
#define IDM_SAVE_ALLOW_NO_PROMPT 1502        // 保存为原尺寸（INI中启用OverwriteOriginalFileWithoutSaveDialog时无需确认）
#define IDM_RELOAD 1600                      // 重新加载图片
#define IDM_PRINT 1700                       // 打印图片
#define IDM_COPY 2000                        // 复制图片到剪贴板（屏幕尺寸）
#define IDM_COPY_FULL 2500                   // 复制图片到剪贴板（原尺寸）
#define IDM_COPY_PATH 2525                   // 复制文件路径到剪贴板
